# Roots n Style environment variables. Copy to .env.local. Never commit real values.

# mock (default): fake backend in the browser, sample data. live: Neon (adapter still to be written).
NEXT_PUBLIC_APP_MODE=mock

# Set to true only at launch. While false the site is noindex, nofollow and robots.txt disallows all.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Mock only. Simulated delay for repo calls in milliseconds. Use off in tests.
NEXT_PUBLIC_MOCK_LATENCY=on

# Minimum time (ms) a visitor must spend on the booking form before submit. Bots are faster. Tests set 0.
NEXT_PUBLIC_MIN_SUBMIT_MS=2000

# ---- live mode only (all required when NEXT_PUBLIC_APP_MODE=live, startup fails without them) ----
# Neon pooled connection string for the app role (server only).
DATABASE_URL=
# Neon Auth (managed Better Auth) base URL.
NEON_AUTH_BASE_URL=
# Neon Object Storage for gallery photos.
NEON_STORAGE_BUCKET=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# SMS and email providers for NotifyPort (live only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
